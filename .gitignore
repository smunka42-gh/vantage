__pycache__/
*.pyc
venv/
.venv/

# Scan + funnel outputs are regenerated, not source. Keeping them out
# means the repo never carries stale data that disagrees with the code.
output/
scripts/*_results.json
scripts/*.log

# Both of these now live in ../vantage-private/, which has no .git and so
# is invisible to this repo entirely — a wall rather than a rule. These
# lines are kept as belt-and-braces: if a file of either name ever
# reappears inside the repo, it is still ignored.
#
#   scratch/       background scan logs, before/after copies for diffing,
#                  draft commit messages
#   BUILD_LOG.md   private session history and decisions in progress
scratch/
BUILD_LOG.md
.preview/
