__pycache__/
*.pyc
venv/
.venv/

# Scan + funnel outputs are regenerated, not source. Keeping them out
# means the repo never carries stale data that disagrees with the code.
output/
scripts/*_results.json
scripts/*.log

# Working files: logs from background scans, before/after copies kept for
# diffing, draft commit messages. Never source, never published. Kept in
# the project rather than a system temp folder so they can be opened and
# read, and ignored here so `git add` can never sweep them into a public
# repo.
scratch/

# Private working notes — session history, decisions in progress.
BUILD_LOG.md
.preview/
