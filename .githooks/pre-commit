#!/bin/sh
# Runs before every commit. Two different jobs, deliberately treated
# differently:
#
#   BLOCK on things a machine can verify. A stale count is a fact, and
#   there is no judgement in it.
#
#   WARN on things only a person can judge. Blocking on judgement trains
#   people to reach for --no-verify, and then the blocking checks stop
#   running too.
#
# Enable with:  git config core.hooksPath .githooks

fail=0

# --- public docs: blocking -------------------------------------------
if [ -f tests/test_docs_current.py ]; then
  PY=.venv/bin/python
  [ -x "$PY" ] || PY=python3
  if ! "$PY" tests/test_docs_current.py >/tmp/vantage_docs.$$ 2>&1; then
    cat /tmp/vantage_docs.$$
    echo
    echo "  Documentation no longer matches the code. Fix it, or use"
    echo "  --no-verify if you genuinely mean to commit it stale."
    fail=1
  fi
  rm -f /tmp/vantage_docs.$$
fi

# --- what this change puts at risk: advisory --------------------------
# A machine cannot judge whether a paragraph's REASONING has gone stale.
# §6 principle 1 was reversed and no test noticed; only reading it did.
# What a machine CAN do is say which documents a change puts at risk, so
# the reading is aimed rather than remembered.
changed=$(git diff --cached --name-only)
risk() { echo "$changed" | grep -qE "$1" && echo "     $2"; }
risky=$(
  risk '^funnel/stage1\.py'  'docs/FUNNEL_SPEC.md §3 — gates, thresholds, §3.19 index result'
  risk '^funnel/stage2\.py'  'docs/FUNNEL_SPEC.md §4 — the below-normal calculation'
  risk '^funnel/stage3\.py'  'docs/FUNNEL_SPEC.md §5 — the two Stage 3 gates'
  risk '^funnel/universe\.py' 'docs/FUNNEL_SPEC.md §2, §3.16 — universe and sector tracks'
  risk '^site/template\.html' 'docs/FUNNEL_SPEC.md §6 — interface principles'
  risk '^site/template_simple' 'docs/FUNNEL_SPEC.md §6 principle 9 — the simple page'
  # detail.js and detail.css are inlined into BOTH pages, so a change here
  # lands on the detailed page and the simple one at once. They were added
  # on 30 Aug and this map did not know about them, so the gate wording
  # rewrite triggered no warning at all.
  risk '^site/detail\.(js|css)' 'docs/FUNNEL_SPEC.md §6, §6.1 — the panel BOTH pages inline'
  risk '^scripts/build_site' 'docs/FUNNEL_SPEC.md §6 — what the page shows'
  risk '^\.github/workflows' 'README.md — how it runs'
)
if [ -n "$risky" ]; then
  echo "  re-read before pushing — a test cannot tell you if the REASONING here is stale:"
  echo "$risky"
fi

# --- private docs: advisory ------------------------------------------
# BUILD_LOG and TODO are outside the repo, so CI can never see them. They
# went 25 commits stale once, which is what this exists to notice.
code_changed=$(git diff --cached --name-only | grep -cE '^(funnel|scripts|site|tests)/' || true)
if [ "$code_changed" -gt 0 ]; then
  last=$(git log -1 --format=%ct 2>/dev/null || echo 0)
  for doc in ../vantage-private/BUILD_LOG.md ../vantage-private/TODO.md; do
    [ -f "$doc" ] || continue
    touched=$(stat -f %m "$doc" 2>/dev/null || stat -c %Y "$doc" 2>/dev/null || echo 0)
    if [ "$touched" -lt "$last" ]; then
      echo "  note: $(basename "$doc") has not been touched since the last commit,"
      echo "        and this one changes code. Decisions and open items live there."
    fi
  done
fi

exit $fail
